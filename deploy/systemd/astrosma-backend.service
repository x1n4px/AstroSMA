[Unit]
Description=AstroSMA Backend
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=in4p
WorkingDirectory=/home/sma/AstroSMA/Backend
EnvironmentFile=/home/sma/AstroSMA/Backend/.env
ExecStart=/bin/bash -lc 'source /home/sma/.nvm/nvm.sh && nvm use 17.9.1 >/dev/null && cd /home/sma/AstroSMA/Backend && exec npm run start'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
