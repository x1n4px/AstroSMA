[Unit]
Description=AstroSMA Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=in4p
WorkingDirectory=/home/sma/AstroSMA/Frontend
EnvironmentFile=/home/sma/AstroSMA/Frontend/.env
ExecStart=/bin/bash -lc 'source /home/sma/.nvm/nvm.sh && nvm use 17.9.1 >/dev/null && cd /home/sma/AstroSMA/Frontend && exec npm run start -- --host 0.0.0.0 --port 5173'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
