[Unit]
Description=AstroSMA Sonificacion Backend
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=in4p
WorkingDirectory=/home/in4p/git/sma/AstroSMA/sonificacion-backend
EnvironmentFile=/home/in4p/git/sma/AstroSMA/sonificacion-backend/.env
ExecStart=/bin/bash /home/in4p/git/sma/AstroSMA/sonificacion-backend/start.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

