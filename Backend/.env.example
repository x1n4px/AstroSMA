# Backend server
PORT=3005
JWT_SECRET=change_this_jwt_secret

# MySQL/MariaDB
DB_HOST=localhost
DB_USER=astro_user
DB_PASSWORD=0000
DB_NAME=astro

# Base path for downloadable files
FULL_PATH=/sma/Meteoros/Detecciones/

# Sonification service URL (tfg-pub/backend)
SONIFICATION_SERVICE_URL=http://127.0.0.1:5000

# Hide Informe_Z reports whose two observatories are at this distance or less (km)
MAX_DISTANCE_OBSERVATORIO=15

# Outgoing email (optional)
EMAIL_USER=
EMAIL_PASS=

# MongoDB for workflow views (optional)
MONGO_URL=
MONGO_HOST=
MONGO_PORT=27017
MONGO_DB=sma_workflows
MONGO_USERNAME=
MONGO_PASSWORD=

# WordPress publishing (optional)
WORDPRESS_ENABLED=false
WORDPRESS_BASE_URL=https://meteoros.astromalaga.es
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=
WORDPRESS_DEFAULT_AUTHOR=
WORDPRESS_DEFAULT_STATUS=draft
WORDPRESS_DEFAULT_CATEGORY=
WORDPRESS_DEFAULT_TAGS=AstroSMA,Workflows,Meteoros
WORDPRESS_TIMEOUT=30000

# YouTube upload integration (optional, consumed by frontend via backend endpoint)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
